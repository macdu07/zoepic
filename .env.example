# Neon Postgres (server-only; use the pooled connection string)
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"

# Google AI (Genkit + Gemini)
GEMINI_API_KEY=your-gemini-api-key

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=http://localhost:9002
NEXT_PUBLIC_APP_URL=http://localhost:9002

# Cloudflare Turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your-turnstile-site-key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# EfiPay Subscriptions (https://efipay.co/docs/1.0/subscription)
EFIPAY_API_TOKEN=your-efipay-api-token
EFIPAY_BASE_URL=https://sag.efipay.co
EFIPAY_OFFICE=your-efipay-office-id
EFIPAY_WEBHOOK_TOKEN=your-efipay-webhook-token
# EFIPAY_GROUP_ID es opcional: si no se define, /api/efipay/setup-plans crea el grupo "ZoePic"
EFIPAY_GROUP_ID=your-efipay-group-id
EFIPAY_PLAN_ID_PRO=your-efipay-plan-id-pro
EFIPAY_PLAN_ID_PRO_ANNUAL=your-efipay-plan-id-pro-annual
EFIPAY_PLAN_ID_AGENCY=your-efipay-plan-id-agency
EFIPAY_PLAN_ID_AGENCY_ANNUAL=your-efipay-plan-id-agency-annual

# Email (SMTP)
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="ZoePic <noreply@example.com>"

# Optional integrations and administration
N8N_WEBHOOK_URL=https://your-n8n-instance.example/webhook/your-webhook
ADMIN_EMAIL=admin@example.com
